# ── Site ──────────────────────────────────────────────────────────────────
# Canonical site origin used to build absolute URLs (canonical tags, sitemap,
# JSON-LD, robots.txt Sitemap: line, redirects). Never hard-code a domain in code.
SITE_URL=https://example.com
SITE_NAME=ContentHub
DEFAULT_LOCALE=vi

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contenthub_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contenthub_test

# ── Redis / Queue ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=ch_session
SESSION_SECRET=change-me-in-production-min-32-chars
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ISSUER=contenthub
SESSION_TTL_DAYS=30

# ── Object storage (S3-compatible) ──────────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=contenthub-media
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=http://localhost:9000/contenthub-media

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SEO / Search Console / Analytics (do not hard-code, do not commit real values) ──
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=

# ── Robots / AI crawlers ────────────────────────────────────────────────
# Comma-separated list of user-agents explicitly disallowed beyond the default
# policy (dashboard/api/admin/auth are always disallowed). Leave empty to allow
# all AI crawlers to read public content by default (see docs/SEO.md #68).
ROBOTS_DISALLOWED_AGENTS=

# ── Revenue (defaults only — real values are admin-configured & versioned
# in revenue_configs; these seed the first RevenueConfig row) ──────────────
REVENUE_DEFAULT_CREATOR_POOL_PERCENTAGE=70
REVENUE_DEFAULT_PLATFORM_PERCENTAGE=25
REVENUE_DEFAULT_FRAUD_RESERVE_PERCENTAGE=5
REVENUE_DEFAULT_CURRENCY=VND
REVENUE_MINIMUM_PAYOUT_THRESHOLD_CENTS=50000000
