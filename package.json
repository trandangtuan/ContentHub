{
  "name": "contenthub",
  "private": true,
  "version": "0.1.0",
  "description": "ContentHub — a User Generated Content platform (Story-first, SEO-first, AI-first)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "dev": "pnpm --parallel -r --filter=./apps/* dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @contenthub/database migrate",
    "db:generate": "pnpm --filter @contenthub/database generate",
    "db:seed": "pnpm --filter @contenthub/database seed"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
